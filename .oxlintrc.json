{
  "ignorePatterns": [
    ".claude-plugin/types/**",
    "cli/dist/**",
    "relay/dist/**"
  ],
  "jsPlugins": ["./lint/anyhost.js"],
  "rules": {
    "anyhost/no-comments": "error"
  },
  "overrides": [
    {
      "files": ["herdr/**/*.js"],
      "rules": {
        "anyhost/ui-tokens": "error",
        "anyhost/ui-primitives": "error"
      }
    }
  ]
}
